# --- Default behavior ---
* text=auto eol=lf
# --- Terraform files ---
*.tf          text eol=lf
*.tfvars      text eol=lf
*.hcl         text eol=lf
# --- Shell scripts (common in provisioning/startup) ---
*.sh          text eol=lf
# --- Config files ---
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
# --- Logs (avoid CRLF issues) ---
*.log         text eol=lf
# --- Minecraft server binaries & assets ---
*.jar         binary
*.zip         binary
*.gz          binary
*.tar         binary
*.tgz         binary
# --- World data (very important: prevent corruption/diffs) ---
*.dat         binary
*.mca         binary
*.nbt         binary
*.region      binary
# --- Images (if you ever include maps/screenshots) ---
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
# --- Windows scripts (if any) ---
*.bat         text eol=crlf
*.ps1         text eol=crlf
# --- Prevent Terraform state conflicts ---
*.tfstate     binary
*.tfstate.*   binary
# --- Lock file should be consistent ---
.terraform.lock.hcl text eol=lf
data/** filter=lfs diff=lfs merge=lfs -text
*.jar !text !filter !merge !diff
*.jar filter=lfs diff=lfs merge=lfs -text
